APP_NAME=Minimal Agent Runtime
APP_ENV=dev
API_PREFIX=/api/v1

# OpenAI-compatible endpoint. Keep the real key only in your local .env file.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

MAX_AGENT_STEPS=8
MAX_CONTEXT_MESSAGES=20
DATABASE_PATH=./data/agent.db

# Development-only JWT secret. Replace with a random secret (>=32 chars).
# Production must always provide a unique secret via a secret manager.
JWT_SECRET=dev-only-insecure-secret-change-before-deploy-000000000000
JWT_ISSUER=minimal-agent-runtime
JWT_AUDIENCE=minimal-agent-api
TRACE_RETENTION_DAYS=30
